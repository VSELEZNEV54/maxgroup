# make init создаёт независимые секреты в .env с правами 0600.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
LOCAL_ADMIN_USER=manager
LOCAL_ADMIN_PASSWORD=
SITE_PORT=8000
PUBLIC_ORIGIN=http://localhost:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SITE_INDEXABLE=0
CRM_ENABLED=0
CRM_DESTINATIONS=amo,bitrix
# Стендовые реквизиты подключаются владельцем отдельно.
AMO_BASE_URL=
AMO_ACCESS_TOKEN=
AMO_EXTERNAL_ID_FIELD=
AMO_PHONE_FIELD=
AMO_DETAILS_FIELD=
BITRIX_WEBHOOK_URL=
BITRIX_EXTERNAL_ID_FIELD=
# Внутренний адрес модели. Диалог обрабатывается на сервере проекта.
CHAT_MODEL_URL=http://chat-model:8080
# Необязательная нормализованная JSON-выгрузка каталога.
CATALOG_FEED_URL=
CATALOG_FEED_SOURCE=
# Object Storage для загрузок Wagtail, локально используется том uploads.
MEDIA_BUCKET=
MEDIA_CDN_DOMAIN=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
